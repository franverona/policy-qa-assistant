# Copy to .env (make dev does this for you). Every variable is required unless marked optional.
# Fake/local values only: never put real secrets in this file.

DATABASE_URL=postgres://policyqa:policyqa@localhost:5432/policyqa

# ollama (default, free, local) | anthropic (optional, paid, chat only)
# record (calls Ollama and writes fixtures/llm/) | fixture (CI/tests: replays fixtures/llm/)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Models (change freely; changing EMBED_MODEL/EMBED_DIM requires re-ingesting)
CHAT_MODEL=qwen3:8b
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
# Task prefixes the embedding model was trained with (quoted to keep the trailing space; empty if none)
EMBED_QUERY_PREFIX="search_query: "
EMBED_DOC_PREFIX="search_document: "
RERANK_MODEL=Xenova/bge-reranker-base

# Optional: only read when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
